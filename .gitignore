# macOS build output
.build/
*.xcuserdatad
.DS_Store

# Built app bundles, ignored at the top of the repository only.
#
# Anchored deliberately: on a case-insensitive macOS filesystem an unanchored `*.app/` also
# matches any source folder whose name ends in `.App`, and once silently kept a whole
# project out of the repository.
/*.app/

# Local ASR model weights. Large, redistributed under their own license, and the app
# downloads them itself.
models/
*.onnx
*.nemo
