<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Fluence</string>
	<key>CFBundleDisplayName</key>
	<string>Fluence</string>
	<!-- Space-free and distinct from any other dictation app's executable, so that
	     `pkill -x`/`killall` on this one can never match another. -->
	<key>CFBundleExecutable</key>
	<string>Fluence</string>
	<!-- TCC keys every grant (Microphone, Accessibility, System Audio Recording) to this
	     identifier. Changing it means granting everything again — FLU-9 decisions 6 and 10. -->
	<key>CFBundleIdentifier</key>
	<string>io.github.clementvnrd.fluence</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- The one place the version is written (FLU-26). The build number is derived from it —
	     major × 10000 + minor × 100 + patch — and a test checks it; Sparkle compares it. -->
	<key>CFBundleShortVersionString</key>
	<string>0.2.1</string>
	<key>CFBundleVersion</key>
	<string>201</string>
	<!-- The app is in French. Declaring it is what makes system menus and Sparkle's update
	     window French too: a framework only speaks a language its app declares. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
	</array>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- `fluence://show` raises the comparison window. Deliberately nothing destructive:
	     any app or web page can open a custom-scheme URL. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.clementvnrd.fluence</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fluence</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- Not an agent at launch: the app starts regular (Dock icon, app menu, windows) and
	     goes to the menu bar by itself when its last window closes, then comes back from the
	     menu bar item (AppPresence, FLU-59). A start at login begins in the background. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Fluence écoute lorsque vous maintenez le raccourci pour transformer votre voix en texte.</string>
	<!-- Notetaker (capture): the calendar gives a call its title and the attendees' names.
	     Requested only when "Use calendar" is on, the first time a meeting needs it. -->
	<!-- Notetaker (capture): the Core Audio process tap that records the other side of a
	     call (TCC "System Audio Recording Only"). Without it the tap delivers silence. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Fluence enregistre les autres participants de votre appel, uniquement pendant la prise de notes de réunion. L'audio reste sur votre Mac.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Fluence lit l'événement en cours pour titrer vos notes de réunion et nommer les intervenants. Rien ne quitte votre Mac.</string>
	<!-- In-app updates (FLU-26), Sparkle 2. SUFeedURL is stamped by the Makefile (one variable,
	     FEED_URL), so a build without a feed never checks. The private half of this key lives
	     in the release machine's login Keychain only (docs/RELEASING.md). -->
	<key>SUPublicEDKey</key>
	<string>N19h9dNndaT9SXnPf7k17VzMbptIFNosW2kiS6TypwY=</string>
	<!-- Check at launch and once a day, without first asking for permission. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Download in the background; Fluence then asks « Installer / Plus tard », and « Plus
	     tard » installs it on quit (AppUpdater). -->
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<!-- No system profile, ever: the request carries nothing about this Mac. -->
	<key>SUEnableSystemProfiling</key>
	<false/>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Fluence transcrit votre voix directement sur votre Mac pour insérer le texte là où vous écrivez.</string>
</dict>
</plist>
