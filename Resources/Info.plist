<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Fluence</string>
	<key>CFBundleDisplayName</key>
	<string>Fluence</string>
	<!-- Space-free and distinct from any other dictation app's executable, so that
	     `pkill -x`/`killall` on this one can never match another. -->
	<key>CFBundleExecutable</key>
	<string>Fluence</string>
	<!-- TCC keys every grant (Microphone, Accessibility, System Audio Recording) to this
	     identifier. Changing it means granting everything again — FLU-9 decisions 6 and 10. -->
	<key>CFBundleIdentifier</key>
	<string>io.github.clementvnrd.fluence</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- `fluence://show` raises the comparison window. Deliberately nothing destructive:
	     any app or web page can open a custom-scheme URL. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.clementvnrd.fluence</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fluence</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- A regular app: dock icon, app menu, standard windows. The menu bar item remains
	     for status and the hotkey while you're working elsewhere, but it is secondary. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Fluence listens while you hold the push-to-talk key so it can turn your speech into text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Fluence transcribes your speech on-device to insert text where you're typing.</string>
</dict>
</plist>
