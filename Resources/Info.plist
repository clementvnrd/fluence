<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Fluence</string>
	<key>CFBundleDisplayName</key>
	<string>Fluence</string>
	<!-- Deliberately space-free and distinct from the existing app's `murmur`, so that
	     `pkill`/`killall` on either app can never match the other. -->
	<key>CFBundleExecutable</key>
	<string>MurmurYouTube</string>
	<!-- Separate from the existing Murmur's com.murmur.client: distinct TCC identity,
	     distinct preferences domain, no shared state of any kind. -->
	<key>CFBundleIdentifier</key>
	<string>ai.pivotstudio.murmur-youtube</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Lets the dashboard's Clear button call back into the app. A file:// page can't
	     write files or talk to a process, but it can follow a custom-scheme link. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.pivotstudio.murmur-youtube</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fluence</string>
				<string>murmuryt</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- A regular app: dock icon, app menu, standard windows. The menu bar item remains
	     for status and the hotkey while you're working elsewhere, but it is secondary. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Fluence écoute lorsque vous maintenez le raccourci pour transformer votre voix en texte.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Fluence transcrit votre voix directement sur votre Mac pour insérer le texte là où vous écrivez.</string>
</dict>
</plist>
