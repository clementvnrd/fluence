<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Same narrow relaxations as Murmur.Dictionary.Tests; see the comment there. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1716;CA1062;CA1034</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Murmur.Meeting\Murmur.Meeting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared Notetaker contract, linked from the repo root rather than copied — the
         macOS side runs the identical file (its Swift copy is checked byte-for-byte in CI). -->
    <None Include="..\..\..\shared\meeting-test-vectors.json"
          Link="meeting-test-vectors.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
