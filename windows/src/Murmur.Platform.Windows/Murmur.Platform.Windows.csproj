<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The ONLY project in the repo allowed to call Win32. Keep it thin: anything with
         logic in it is code CI cannot exercise. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Murmur.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- REQUIRED for NAudio to ship at all. Class libraries do not copy NuGet dependencies
         to their bin by default, and Murmur.App picks this layer's output up with a
         "NAudio*.dll" glob (see Murmur.App.csproj) precisely because it cannot reference
         this project's dependency graph. Without this, the glob matches nothing, publish
         succeeds, and audio capture dies at runtime with FileNotFoundException on the first
         real recording — which is how it escaped CI. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio.Core + NAudio.Wasapi, NOT the "NAudio" meta-package: it drags in
         NAudio.WinForms, whose FrameworkReference to Microsoft.WindowsDesktop.App makes the
         SDK on Windows treat ProtectedData and SystemEvents as framework-provided and stop
         copying them — but Fluence.exe runs on Microsoft.NETCore.App alone, so they would be
         missing at runtime. Only WASAPI capture and the wave/sample-provider types are used. -->
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Murmur.Abstractions\Murmur.Abstractions.csproj" />
  </ItemGroup>
</Project>
