{
  "version": 1,
  "about": "Behavioural contract for the Notetaker's platform-neutral logic: token normalisation, mic/system merge with the echo backstop, word-to-speaker assignment, segment attribution and speaker naming. Both the macOS (FluenceMeetingCore) and Windows implementations must run every case. The rules are documented in Sources/FluenceMeetingCore (TextTokens, TranscriptMerger, SpeakerAssignment, SpeakerNaming). Times are seconds from the meeting start. The Swift copy in Tests/FluenceMeetingCoreTests must stay identical to this file.",
  "normalization": [
    { "name": "punctuation and apostrophes split words, accents fold", "input": "Bonjour, l'équipe !", "tokens": ["bonjour", "l", "equipe"] },
    { "name": "uppercase, digits and a dash", "input": "Q3 RÉSULTATS—OK?", "tokens": ["q3", "resultats", "ok"] },
    { "name": "compatibility ligatures decompose", "input": "naïve café ﬁnal", "tokens": ["naive", "cafe", "final"] },
    { "name": "blank text has no tokens", "input": "  ... ", "tokens": [] }
  ],
  "merge": [
    {
      "name": "a delayed echo of remote speech is dropped from the mic",
      "mic": [
        { "source": "microphone", "speakerID": "me", "start": 10.5, "end": 13.2, "text": "should ship the beta on Friday" }
      ],
      "system": [
        { "source": "system", "speakerID": "S?", "start": 10.0, "end": 13.0, "text": "We should ship the beta on Friday.",
          "words": [
            { "text": "We", "start": 10.0, "end": 10.3 }, { "text": "should", "start": 10.3, "end": 10.6 },
            { "text": "ship", "start": 10.6, "end": 11.0 }, { "text": "the", "start": 11.0, "end": 11.2 },
            { "text": "beta", "start": 11.2, "end": 11.7 }, { "text": "on", "start": 11.7, "end": 12.0 },
            { "text": "Friday.", "start": 12.0, "end": 12.6 } ] }
      ],
      "expected": [
        { "source": "system", "start": 10.0, "text": "We should ship the beta on Friday." }
      ]
    },
    {
      "name": "the user's own reply sharing one word is kept, in time order",
      "mic": [
        { "source": "microphone", "speakerID": "me", "start": 13.5, "end": 15.0, "text": "Friday works for me" }
      ],
      "system": [
        { "source": "system", "speakerID": "S?", "start": 10.0, "end": 13.0, "text": "We should ship the beta on Friday.",
          "words": [
            { "text": "We", "start": 10.0, "end": 10.3 }, { "text": "should", "start": 10.3, "end": 10.6 },
            { "text": "ship", "start": 10.6, "end": 11.0 }, { "text": "the", "start": 11.0, "end": 11.2 },
            { "text": "beta", "start": 11.2, "end": 11.7 }, { "text": "on", "start": 11.7, "end": 12.0 },
            { "text": "Friday.", "start": 12.0, "end": 12.6 } ] }
      ],
      "expected": [
        { "source": "system", "start": 10.0, "text": "We should ship the beta on Friday." },
        { "source": "microphone", "start": 13.5, "text": "Friday works for me" }
      ]
    },
    {
      "name": "a system segment without word timings is split evenly; its echo is dropped",
      "mic": [
        { "source": "microphone", "speakerID": "me", "start": 21.0, "end": 22.5, "text": "Merci beaucoup à tous" }
      ],
      "system": [
        { "source": "system", "speakerID": "S?", "start": 20.0, "end": 22.0, "text": "Merci beaucoup à tous." }
      ],
      "expected": [
        { "source": "system", "start": 20.0, "text": "Merci beaucoup à tous." }
      ]
    },
    {
      "name": "a Jaccard of exactly 0.6 is kept (only strictly greater drops)",
      "mic": [
        { "source": "microphone", "speakerID": "me", "start": 30.2, "end": 32.0, "text": "yes the budget is fine" }
      ],
      "system": [
        { "source": "system", "speakerID": "S?", "start": 30.0, "end": 32.0, "text": "the budget is approved",
          "words": [
            { "text": "the", "start": 30.0, "end": 30.4 }, { "text": "budget", "start": 30.4, "end": 31.0 },
            { "text": "is", "start": 31.0, "end": 31.3 }, { "text": "approved", "start": 31.3, "end": 32.0 } ] }
      ],
      "expected": [
        { "source": "system", "start": 30.0, "text": "the budget is approved" },
        { "source": "microphone", "start": 30.2, "text": "yes the budget is fine" }
      ]
    },
    {
      "name": "equal start times put the microphone first",
      "mic": [
        { "source": "microphone", "speakerID": "me", "start": 40.0, "end": 41.0, "text": "okay" }
      ],
      "system": [
        { "source": "system", "speakerID": "S?", "start": 40.0, "end": 42.0, "text": "let's move on" }
      ],
      "expected": [
        { "source": "microphone", "start": 40.0, "text": "okay" },
        { "source": "system", "start": 40.0, "text": "let's move on" }
      ]
    },
    {
      "name": "identical words more than 1.5 s apart are not an echo",
      "mic": [
        { "source": "microphone", "speakerID": "me", "start": 53.0, "end": 54.0, "text": "see you tomorrow" }
      ],
      "system": [
        { "source": "system", "speakerID": "S?", "start": 50.0, "end": 51.0, "text": "See you tomorrow",
          "words": [
            { "text": "See", "start": 50.0, "end": 50.3 }, { "text": "you", "start": 50.3, "end": 50.6 },
            { "text": "tomorrow", "start": 50.6, "end": 51.0 } ] }
      ],
      "expected": [
        { "source": "system", "start": 50.0, "text": "See you tomorrow" },
        { "source": "microphone", "start": 53.0, "text": "see you tomorrow" }
      ]
    }
  ],
  "wordSpeaker": [
    {
      "name": "the turn with the largest overlap wins",
      "turns": [ { "speaker": "A", "start": 0.0, "end": 2.0 }, { "speaker": "B", "start": 2.0, "end": 4.0 } ],
      "words": [ { "text": "one", "start": 0.5, "end": 1.0 }, { "text": "two", "start": 1.8, "end": 2.6 }, { "text": "three", "start": 3.0, "end": 3.5 } ],
      "expected": ["A", "B", "B"]
    },
    {
      "name": "equal overlap goes to the earlier turn, then the smaller label",
      "turns": [ { "speaker": "B", "start": 1.0, "end": 2.0 }, { "speaker": "A", "start": 2.0, "end": 3.0 }, { "speaker": "Z", "start": 5.0, "end": 6.0 }, { "speaker": "Y", "start": 5.0, "end": 6.0 } ],
      "words": [ { "text": "split", "start": 1.5, "end": 2.5 }, { "text": "same", "start": 5.2, "end": 5.4 } ],
      "expected": ["B", "Y"]
    },
    {
      "name": "no overlap: the nearest turn within 1 s, otherwise unattributed",
      "turns": [ { "speaker": "A", "start": 0.0, "end": 1.0 }, { "speaker": "B", "start": 3.0, "end": 4.0 } ],
      "words": [ { "text": "near", "start": 1.5, "end": 1.8 }, { "text": "later", "start": 2.6, "end": 2.8 }, { "text": "far", "start": 10.0, "end": 10.5 } ],
      "expected": ["A", "B", null]
    },
    {
      "name": "a zero-length word inside a turn belongs to it",
      "turns": [ { "speaker": "A", "start": 0.0, "end": 2.0 } ],
      "words": [ { "text": "point", "start": 1.0, "end": 1.0 } ],
      "expected": ["A"]
    },
    {
      "name": "without turns nothing is attributed",
      "turns": [],
      "words": [ { "text": "alone", "start": 1.0, "end": 1.5 } ],
      "expected": [null]
    }
  ],
  "attribution": [
    {
      "name": "a segment is split where the voice changes; voices are renamed by first appearance",
      "fallbackID": "S?",
      "turns": [ { "speaker": "spk_7", "start": 0.0, "end": 1.5 }, { "speaker": "spk_2", "start": 2.0, "end": 4.0 }, { "speaker": "spk_7", "start": 5.0, "end": 6.0 } ],
      "segments": [
        { "source": "system", "speakerID": "S?", "start": 5.0, "end": 6.0, "text": "Thanks!",
          "words": [ { "text": "Thanks!", "start": 5.2, "end": 5.6 } ] },
        { "source": "system", "speakerID": "S?", "start": 0.0, "end": 4.0, "text": "Hello there. How are you?",
          "words": [
            { "text": "Hello", "start": 0.0, "end": 0.5 }, { "text": "there.", "start": 0.5, "end": 1.0 },
            { "text": "How", "start": 2.2, "end": 2.5 }, { "text": "are", "start": 2.5, "end": 2.8 }, { "text": "you?", "start": 2.8, "end": 3.2 } ] }
      ],
      "expected": [
        { "speakerID": "S1", "start": 0.0, "end": 1.0, "text": "Hello there." },
        { "speakerID": "S2", "start": 2.2, "end": 3.2, "text": "How are you?" },
        { "speakerID": "S1", "start": 5.0, "end": 6.0, "text": "Thanks!" }
      ],
      "labels": { "spk_7": "S1", "spk_2": "S2" }
    },
    {
      "name": "unattributed words inherit from neighbours; a segment far from every turn gets the fallback",
      "fallbackID": "S?",
      "turns": [ { "speaker": "x", "start": 2.0, "end": 3.0 } ],
      "segments": [
        { "source": "system", "speakerID": "S?", "start": 0.0, "end": 3.0, "text": "Um, yes.",
          "words": [ { "text": "Um,", "start": 0.0, "end": 0.1 }, { "text": "yes.", "start": 2.1, "end": 2.4 } ] },
        { "source": "system", "speakerID": "S?", "start": 10.0, "end": 11.0, "text": "Okay.",
          "words": [ { "text": "Okay.", "start": 10.2, "end": 10.5 } ] }
      ],
      "expected": [
        { "speakerID": "S1", "start": 0.0, "end": 3.0, "text": "Um, yes." },
        { "speakerID": "S?", "start": 10.0, "end": 11.0, "text": "Okay." }
      ],
      "labels": { "x": "S1" }
    },
    {
      "name": "a segment without words is attributed by its span",
      "fallbackID": "S?",
      "turns": [ { "speaker": "b", "start": 0.5, "end": 3.0 }, { "speaker": "a", "start": 1.5, "end": 1.8 } ],
      "segments": [
        { "source": "system", "speakerID": "S?", "start": 0.0, "end": 2.0, "text": "Bonjour." }
      ],
      "expected": [
        { "speakerID": "S1", "start": 0.0, "end": 2.0, "text": "Bonjour." }
      ],
      "labels": { "b": "S1" }
    }
  ],
  "naming": [
    {
      "name": "one remote voice and one participant in the meeting window",
      "speakers": [ { "id": "me" }, { "id": "S1" } ],
      "windowParticipants": ["Ada Lovelace"], "attendees": [], "voicePrintSimilarity": {},
      "expected": [ { "id": "me" }, { "id": "S1", "name": "Ada Lovelace", "nameSource": "meetingWindow" } ]
    },
    {
      "name": "a name the user typed is never overwritten or reused; the window fills the last voice by elimination",
      "speakers": [ { "id": "me" }, { "id": "S1", "name": "Grace", "nameSource": "user" }, { "id": "S2" } ],
      "windowParticipants": ["grace", "Alan Turing"], "attendees": [], "voicePrintSimilarity": {},
      "expected": [ { "id": "me" }, { "id": "S1", "name": "Grace", "nameSource": "user" }, { "id": "S2", "name": "Alan Turing", "nameSource": "meetingWindow" } ]
    },
    {
      "name": "voice prints use a global assignment, not greedy best-first",
      "speakers": [ { "id": "S1" }, { "id": "S2" } ],
      "windowParticipants": [], "attendees": ["Ada", "Bob"],
      "voicePrintSimilarity": { "S1": { "Ada": 0.80, "Bob": 0.75 }, "S2": { "Ada": 0.78, "Bob": 0.40 } },
      "expected": [ { "id": "S1", "name": "Bob", "nameSource": "voicePrint" }, { "id": "S2", "name": "Ada", "nameSource": "voicePrint" } ]
    },
    {
      "name": "the last attendee goes to the last unnamed voice",
      "speakers": [ { "id": "me" }, { "id": "S1", "name": "Ada", "nameSource": "user" }, { "id": "S2" } ],
      "windowParticipants": [], "attendees": ["Ada", "Bob"], "voicePrintSimilarity": {},
      "expected": [ { "id": "me" }, { "id": "S1", "name": "Ada", "nameSource": "user" }, { "id": "S2", "name": "Bob", "nameSource": "calendar" } ]
    },
    {
      "name": "a weak voice match and two possible attendees leave the voice unnamed",
      "speakers": [ { "id": "S1" } ],
      "windowParticipants": [], "attendees": ["Ada", "Bob"],
      "voicePrintSimilarity": { "S1": { "Ada": 0.40 } },
      "expected": [ { "id": "S1" } ]
    }
  ]
}
